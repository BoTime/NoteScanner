dist
node_modules

# Scratch file holding the dev `exports` map while `npm pack`/`npm publish` runs
# (written by scripts/prepack-exports.mjs, removed by scripts/postpack-exports.mjs)
.exports-dev-backup.json
# Tarballs produced by `npm pack`
*.tgz

# autopilot run state (per-run ledgers, verify artifacts) and the isolated
# worktrees a run works in. Neither belongs in git.
.superpowers/
.claude/worktrees/

# Playwright run artifacts (traces, error context, HTML report)
test-results/
playwright-report/

{
  "name": "@botime/note-scanner",
  "version": "0.1.0",
  "description": "In-browser post-it note scanner: a React segment/mask viewer with an optional WebGPU SAM segmenter",
  "license": "MIT",
  "author": "BoTime",
  "homepage": "https://github.com/BoTime/NoteScanner#readme",
  "bugs": {
    "url": "https://github.com/BoTime/NoteScanner/issues"
  },
  "keywords": [
    "react",
    "segmentation",
    "sam",
    "segment-anything",
    "webgpu",
    "canvas",
    "mask",
    "ocr",
    "post-it",
    "whiteboard"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "development": "./src/core/index.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./segmenter": {
      "types": "./dist/segmenter/index.d.ts",
      "development": "./src/segmenter/index.ts",
      "import": "./dist/segmenter/index.js",
      "require": "./dist/segmenter/index.cjs"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js",
        "require": "./dist/core/index.cjs"
      },
      "./segmenter": {
        "types": "./dist/segmenter/index.d.ts",
        "import": "./dist/segmenter/index.js",
        "require": "./dist/segmenter/index.cjs"
      },
      "./styles.css": "./dist/segment-viewer.css",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoTime/NoteScanner.git"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.playground.json",
    "playground": "vite --config playground/vite.config.ts",
    "sweep:decode": "node scripts/sweep-decode.mjs",
    "smoke": "npm run build && node scripts/smoke-build.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "node scripts/prepack-exports.mjs",
    "postpack": "node scripts/postpack-exports.mjs"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
